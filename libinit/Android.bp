cc_library_static {
    name: "init_xiaomi_munch",
    srcs: [
        "init_xiaomi_munch.cpp",
        "libinit_dalvik_heap.cpp",
        "libinit_variant.cpp",
        "libinit_utils.cpp",
    ],
    header_libs: ["libvariant_headers"],
    whole_static_libs: [
        "libbase",
        "libvariant_xiaomi_munch",
    ],
    include_dirs: ["system/core/init"],
    recovery_available: true,
}

